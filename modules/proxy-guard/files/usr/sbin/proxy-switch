#!/bin/sh
# proxy-switch <passwall|homeproxy|nikki|openclash|off> [--keep-record] [--keep-enabled]
# proxy-switch --ensure <passwall|homeproxy|nikki|openclash>
#
# 只允许一个代理前端处于启用状态：停用其余前端、清理其残留 nftables 表，
# 再启用目标前端。失败时返回非 0，不静默吞掉错误。
#
# 两种“停用”必须区分：
#   * 用户明确关闭 / 切换前端：同时停止服务、清 enabled 标志、删 rc.d 链接。
#   * fail-open 临时直连：只停止运行中的服务，保留 enabled 标志和 rc.d 链接，
#     这样重启后用户的选择仍然有效（--keep-enabled）。
set -u

ACTIVE=""
ENSURE=0
NO_START=0
KEEP_RECORD=0
KEEP_ENABLED=0

for arg in "$@"; do
	case "$arg" in
		--ensure)       ENSURE=1 ;;
		--no-start)     NO_START=1 ;;
		--keep-record)  KEEP_RECORD=1 ;;
		--keep-enabled) KEEP_ENABLED=1 ;;
		passwall|homeproxy|nikki|openclash|off) ACTIVE="$arg" ;;
		*)
			echo "usage: proxy-switch <passwall|homeproxy|nikki|openclash|off> [--keep-record] [--keep-enabled]" >&2
			echo "       proxy-switch --ensure <passwall|homeproxy|nikki|openclash>" >&2
			exit 2
			;;
	esac
done
[ -n "$ACTIVE" ] || { echo "proxy-switch: missing frontend" >&2; exit 2; }

SVCS="passwall homeproxy nikki openclash"
LOCK=/var/lock/proxy-switch.lock

log() { logger -t proxy-switch "$*"; }

svc_installed() { [ -x "/etc/init.d/$1" ]; }

uci_enabled_key() {
	case "$1" in
		passwall)  echo 'passwall.@global[0].enabled' ;;
		homeproxy) echo 'homeproxy.config.enabled' ;;
		nikki)     echo 'nikki.@nikki[0].enabled' ;;
		openclash) echo 'openclash.config.enable' ;;
		*)         echo '' ;;
	esac
}

set_enabled() {
	key="$(uci_enabled_key "$1")"
	[ -n "$key" ] || return 0
	[ "$(uci -q get "$key" 2>/dev/null)" = "$2" ] && return 0
	uci -q set "$key=$2" 2>/dev/null || true
	uci -q commit "$1" 2>/dev/null || true
}

record_active() {
	[ "$(uci -q get proxy-guard.main.active 2>/dev/null)" = "$1" ] && return 0
	uci -q set "proxy-guard.main.active=$1" 2>/dev/null || true
	uci -q commit proxy-guard 2>/dev/null || true
}

running() {
	case "$1" in
		# HomeProxy keeps a log-cleaner instance alive even when sing-box has
		# exited, so a generic procd/pid check is a false positive here.
		homeproxy)
			pgrep -f '[s]ing-box[[:space:]]+run[[:space:]].*sing-box-[cs]\.json' >/dev/null 2>&1
			;;
		passwall)
			pgrep -f '[/](tmp|var)/etc/passwall/bin/(xray|sing-box|ss-local|ss-redir|sslocal|ssr-local|ssr-redir|trojan|trojan-plus|hysteria|hysteria2|tuic-client|naive|naiveproxy|ipt2socks)([[:space:]]|$)' >/dev/null 2>&1
			;;
		openclash)
			pgrep -f '[c]lash' >/dev/null 2>&1
			;;
		nikki)
			pgrep -f '[m]ihomo' >/dev/null 2>&1
			;;
		*)
			ubus call service list "{\"name\":\"$1\"}" 2>/dev/null | grep -q '"pid"'
			;;
	esac
}

# HomeProxy writes its log/config under /var/run/homeproxy before procd starts.
# /var/run is tmpfs, so the directory has to exist on every boot before any
# reload/stop path logs to it.
ensure_runtime_dir() {
	case "$1" in
		homeproxy)
			mkdir -p /var/run/homeproxy 2>/dev/null || true
			chmod 755 /var/run/homeproxy 2>/dev/null || true
			chown sing-box:sing-box /var/run/homeproxy 2>/dev/null || true
			;;
		passwall)  mkdir -p /var/run/passwall 2>/dev/null || true ;;
		openclash) mkdir -p /var/run/openclash 2>/dev/null || true ;;
		nikki)     mkdir -p /var/run/nikki 2>/dev/null || true ;;
	esac
}

cleanup_tables() {
	for t in passwall homeproxy nikki openclash; do
		# A running target owns these rules; --ensure must preserve them.
		[ "$t" = "$ACTIVE" ] && continue
		if nft list table inet "$t" >/dev/null 2>&1; then
			if nft delete table inet "$t" 2>/dev/null; then
				log "removed stale nft table inet $t"
			fi
		fi
	done
}

# Serialise concurrent switches (UI + watchdog + boot reconcile + hotplug).
if ! mkdir "$LOCK" 2>/dev/null; then
	if [ -n "$(find "$LOCK" -maxdepth 0 -mmin +5 2>/dev/null)" ]; then
		log "removing stale lock $LOCK"
		rmdir "$LOCK" 2>/dev/null
	fi
	if ! mkdir "$LOCK" 2>/dev/null; then
		echo "proxy-switch: another switch is in progress" >&2
		exit 3
	fi
fi
trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM

PREV="$(uci -q get proxy-guard.main.active 2>/dev/null)"

# Check the target before touching anything: switching to a frontend that is
# not installed must not disable the working one.
if [ "$ACTIVE" != "off" ] && ! svc_installed "$ACTIVE"; then
	log "service $ACTIVE is not installed; nothing changed"
	echo "proxy-switch: $ACTIVE is not installed" >&2
	exit 1
fi

for s in $SVCS; do
	[ "$s" = "$ACTIVE" ] && continue
	svc_installed "$s" || continue
	log "disabling $s"
	key="$(uci_enabled_key "$s")"
	# Avoid stopping already-disabled plugins on every watchdog tick.
	if [ "$(uci -q get "$key" 2>/dev/null)" = "1" ] || \
		/etc/init.d/"$s" enabled >/dev/null 2>&1 || running "$s"; then
		/etc/init.d/"$s" stop >/dev/null 2>&1
	fi
	[ "$KEEP_ENABLED" -eq 1 ] || set_enabled "$s" 0
	[ "$KEEP_ENABLED" -eq 1 ] || /etc/init.d/"$s" disable >/dev/null 2>&1
done

# Clear partial runtime state before a retry. Preserve a running target on
# --ensure, and leave boot startup to S99 when --no-start was requested.
if [ "$ACTIVE" != "off" ] && [ "$NO_START" -eq 0 ]; then
	if [ "$ENSURE" -eq 0 ] || ! running "$ACTIVE"; then
		ensure_runtime_dir "$ACTIVE"
		/etc/init.d/"$ACTIVE" stop >/dev/null 2>&1
	fi
fi
cleanup_tables

if [ "$ACTIVE" != "off" ]; then
	ensure_runtime_dir "$ACTIVE"
	log "enabling $ACTIVE"
	set_enabled "$ACTIVE" 1
	/etc/init.d/"$ACTIVE" enabled >/dev/null 2>&1 || /etc/init.d/"$ACTIVE" enable >/dev/null 2>&1

	if [ "$NO_START" -eq 1 ]; then
		log "$ACTIVE enabled; start deferred to its own boot script"
	elif [ "$ENSURE" -eq 1 ] && running "$ACTIVE"; then
		log "$ACTIVE already running; keeping it"
	else
		if ! /etc/init.d/"$ACTIVE" start >/dev/null 2>&1; then
			log "failed to start $ACTIVE"
			/etc/init.d/"$ACTIVE" stop >/dev/null 2>&1
			cleanup_tables
			if [ -n "$PREV" ] && [ "$PREV" != "off" ] && [ "$PREV" != "$ACTIVE" ] && svc_installed "$PREV"; then
				log "restoring previous frontend $PREV"
				set_enabled "$PREV" 1
				/etc/init.d/"$PREV" enable >/dev/null 2>&1
				if /etc/init.d/"$PREV" restart >/dev/null 2>&1; then
					[ "$KEEP_RECORD" -eq 1 ] || record_active "$PREV"
					echo "proxy-switch: failed to start $ACTIVE, restored $PREV" >&2
					exit 1
				fi
				log "could not restore $PREV either"
			fi
			# Keep the choice so later reconciliation can retry a failed start.
			[ "$KEEP_RECORD" -eq 1 ] || record_active "$ACTIVE"
			echo "proxy-switch: failed to start $ACTIVE; direct routing left active" >&2
			exit 1
		fi
	fi
fi

if [ "$KEEP_RECORD" -eq 0 ]; then
	record_active "$ACTIVE"
fi

log "active=$ACTIVE"
exit 0
