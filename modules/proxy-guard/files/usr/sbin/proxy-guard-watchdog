#!/bin/sh
# proxy-guard-watchdog — 分级探测 + fail-open 恢复。
#
# 不是"挂了就重启"：连续失败达到阈值后按 policy 处理。
#   policy=open   停用代理、恢复直连（fail-open），冷却 recover_delay 秒后尝试切回
#   policy=closed 保留代理原状，只记录和通知，不静默放行直连
set -u
. /lib/functions.sh

config_load proxy-guard
config_get POLICY main policy open
config_get INTERVAL main interval 60
config_get FAILS main fail_threshold 3
config_get RECOVER_DELAY main recover_delay 600
config_get PROBE main probe_url 'http://www.gstatic.com/generate_204'
config_get DNS main probe_dns '223.5.5.5'
config_get NOTIFY main notify 1

log() { logger -t proxy-guard "$*"; }

notify() {
	[ "$NOTIFY" = "1" ] || return 0
	command -v wechatpush >/dev/null 2>&1 || return 0
	wechatpush send "ImmortalWrt 代理状态" "$1" >/dev/null 2>&1 || true
}

probe_dns() { nslookup www.baidu.com "$DNS" >/dev/null 2>&1; }

probe_http() {
	code="$(curl -s -o /dev/null -m 8 -w '%{http_code}' "$PROBE" 2>/dev/null)"
	[ "$code" = "204" ] || [ "$code" = "200" ]
}

healthy() { probe_dns && probe_http; }

active_proxy() { uci -q get proxy-guard.main.active 2>/dev/null; }

trap 'log "watchdog stopping"; exit 0' TERM INT

log "started policy=$POLICY interval=${INTERVAL}s threshold=$FAILS"
fails=0
mode=normal
failopen_since=0
backoff=$INTERVAL

while :; do
	if healthy; then
		fails=0
		backoff=$INTERVAL
		if [ "$mode" = "failopen" ]; then
			now="$(date +%s)"
			if [ $((now - failopen_since)) -ge "$RECOVER_DELAY" ]; then
				proxy="$(active_proxy)"
				if [ -n "$proxy" ] && [ "$proxy" != "off" ]; then
					log "recovery window elapsed, re-enabling $proxy"
					if /usr/sbin/proxy-switch "$proxy" >/dev/null 2>&1; then
						mode=normal
					fi
				else
					mode=normal
				fi
			fi
		fi
		sleep "$INTERVAL"
		continue
	fi

	fails=$((fails + 1))
	log "probe failed ($fails/$FAILS)"
	if [ "$fails" -ge "$FAILS" ]; then
		if [ "$POLICY" = "closed" ]; then
			log "fail-closed: keeping proxy state, not bypassing"
			notify "代理异常，按 fail-closed 策略不放行直连"
		else
			log "fail-open: disabling proxy, restoring direct routing"
			/usr/sbin/proxy-switch off --keep-record >/dev/null 2>&1
			notify "代理异常，已切到直连（fail-open）"
			mode=failopen
			failopen_since="$(date +%s)"
		fi
		fails=0
	fi

	sleep "$backoff"
	backoff=$((backoff * 2))
	[ "$backoff" -gt 1800 ] && backoff=1800
done
