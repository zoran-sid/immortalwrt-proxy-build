#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

service_triggers() {
	procd_open_trigger
	local package
	for package in homeproxy passwall nikki openclash; do
		procd_add_config_trigger "config.change" "$package" /usr/sbin/proxy-guard-reconcile --event "$package"
	done
	procd_close_trigger
}

start_service() {
	if [ -x /usr/sbin/homeproxy-config-patch ]; then
		/usr/sbin/homeproxy-config-patch || logger -t proxy-guard "HomeProxy config compatibility patch failed"
	fi
	# Make HomeProxy's stop/reload log path safe before S99homeproxy runs.
	if [ -x /usr/sbin/homeproxy-runtime-patch ]; then
		/usr/sbin/homeproxy-runtime-patch >/dev/null 2>&1
	fi

	# /var/run is tmpfs: HomeProxy logs into /var/run/homeproxy even on the
	# reload/stop paths, so create it before any frontend starts.
	if [ -x /etc/init.d/homeproxy ]; then
		mkdir -p /var/run/homeproxy 2>/dev/null || true
		chmod 755 /var/run/homeproxy 2>/dev/null || true
		chown sing-box:sing-box /var/run/homeproxy 2>/dev/null || true
	fi

	# Reconcile the saved frontend choice before the per-frontend S99 scripts.
	if [ -x /usr/sbin/proxy-guard-reconcile ]; then
		/usr/sbin/proxy-guard-reconcile --boot >/dev/null 2>&1
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/proxy-guard-watchdog
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/proxy-guard
	procd_close_instance

	# A separate boot-only worker retries HomeProxy every 5 seconds without
	# changing the watchdog's 60-second probe interval or fail-open thresholds.
	if [ -x /usr/sbin/homeproxy-boot-retry ]; then
		procd_open_instance homeproxy-boot
		procd_set_param command /usr/sbin/homeproxy-boot-retry
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

reload_service() {
	stop
	start
}
